<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- Dynamic Background with rounded corners & customizable opacity -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Compact Slim Banner: Cover on LEFT, Info in CENTER, Controls on RIGHT -->
    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Left: Album Artwork (Scales with widget height) -->
        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_notification"
            android:contentDescription="Album Artwork" />

        <!-- Center: Logo + Title + Artist -->
        <LinearLayout
            android:id="@+id/widget_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- XVOX Branding in Cinzel Font -->
            <ImageView
                android:id="@+id/widget_logo_xvox"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginBottom="2dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="XVOX Logo" />

            <!-- Song Title -->
            <TextView
                android:id="@+id/widget_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="XVOX Player"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Artist -->
            <TextView
                android:id="@+id/widget_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready to play"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right: Control Buttons -->
        <LinearLayout
            android:id="@+id/widget_controls_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Like Heart Button -->
            <ImageView
                android:id="@+id/widget_btn_like"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="3dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Like" />

            <!-- Previous Button -->
            <ImageView
                android:id="@+id/widget_btn_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:padding="3dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Previous" />

            <!-- Play / Pause Button -->
            <ImageView
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="4dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Play/Pause" />

            <!-- Next Button -->
            <ImageView
                android:id="@+id/widget_btn_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="3dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Next" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
